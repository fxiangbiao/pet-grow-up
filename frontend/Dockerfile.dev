# Development Dockerfile for PetGrowUp Frontend
# 源码通过 WSL 卷挂载，这里只安装依赖
FROM node:22-alpine

WORKDIR /app

# 安装依赖
COPY package.json package-lock.json ./
RUN npm ci

# 生成 .svelte-kit 目录（消除 tsconfig 警告）
RUN npm run sync 2>/dev/null || true

EXPOSE 3000

ENV NODE_ENV=development
ENV HOST=0.0.0.0
ENV PORT=3000

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "3000"]
